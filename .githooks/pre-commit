#!/bin/sh

set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "Cannot locate the Git worktree for plugin generation." >&2
  exit 1
}
helper="$repo_root/dist/maintainer/pre-commit.cjs"

if ! command -v node >/dev/null 2>&1; then
  echo "KCodeRag pre-commit verification requires Node.js 22 or newer." >&2
  exit 1
fi

if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' >/dev/null 2>&1; then
  echo "KCodeRag pre-commit verification requires Node.js 22 or newer." >&2
  exit 1
fi

if [ ! -f "$helper" ]; then
  echo "KCodeRag pre-commit helper is missing. Run npm run build." >&2
  exit 1
fi

exec node "$helper"
