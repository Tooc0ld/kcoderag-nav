{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node -e 'Function(\"require\",\"process\",Buffer.from(process.argv[1],\"base64\").toString(\"utf8\"))(require,process)'  claude .claude/kcoderag-nav/install-state.json .claude/kcoderag-nav/qa/hooks/run_marker.sh posix 2>/dev/null || :",
            "commandWindows": "node -e \"Function('require','process',Buffer.from(process.argv[1],'base64').toString('utf8'))(require,process)\"  claude .claude/kcoderag-nav/install-state.json .claude/kcoderag-nav/qa/hooks/run_marker.cmd windows 2>nul & exit /b 0",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^mcp__kcoderag-qa__.*$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "additionalContextLimit": 600,
            "command": "node -e 'Function(\"require\",\"process\",Buffer.from(process.argv[1],\"base64\").toString(\"utf8\"))(require,process)'  claude .claude/kcoderag-nav/install-state.json .claude/kcoderag-nav/qa/hooks/run_hook.sh posix 2>/dev/null || :",
            "commandWindows": "node -e \"Function('require','process',Buffer.from(process.argv[1],'base64').toString('utf8'))(require,process)\"  claude .claude/kcoderag-nav/install-state.json .claude/kcoderag-nav/qa/hooks/run_hook.cmd windows 2>nul & exit /b 0",
            "statusMessage": "Checking project guidance",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(Grep|Glob|Bash|Write|Edit|MultiEdit|apply_patch)$"
      }
    ]
  }
}
