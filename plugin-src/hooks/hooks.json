{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Grep|Glob|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.sh\"",
            "commandWindows": "call \"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\"",
            "timeout": 5,
            "statusMessage": "Checking code lookup strategy",
            "additionalContextLimit": 600
          }
        ]
      }
    ]
  }
}
