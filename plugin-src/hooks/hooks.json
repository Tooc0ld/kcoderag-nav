{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Grep|Glob|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{project_hook_command_posix}}",
            "commandWindows": "{{project_hook_command_windows}}",
            "timeout": 5,
            "statusMessage": "Checking code lookup strategy",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__kcoderag-qa__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "{{project_marker_command_posix}}",
            "commandWindows": "{{project_marker_command_windows}}",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
